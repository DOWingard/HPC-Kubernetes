{"version": 2, "width": 140, "height": 40, "timestamp": 1791083011, "idle_time_limit": 2.0, "env": {"SHELL": "/bin/bash", "TERM": null}, "title": "hpclab: REST API -> Slurm -> bare-metal + Kubernetes burst"}
[0.552801, "o", "\r\n\u001b[1;36m# Cluster capacity: bare-metal partition is online, burst partition is powered down (idle~)\u001b[0m\r\n\u001b[2m$ curl -s http://localhost:30080/cluster -H \"Authorization: Bearer $ALICE\" | jq -c '.partitions'\u001b[0m\r\n"]
[0.684198, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"local-node\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"nodes\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m1\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"nodes_powered_up\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m1\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"cpus\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m4\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"alloc_cpus\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m0\u001b[0m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"k8s-burst\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"nodes\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m4\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"nodes_powered_up\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m0\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"cpus\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m8\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"alloc_cpus\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m0\u001b[0m\u001b[1;39m}\u001b[0m\u001b[1;39m}\u001b[0m\r\n"]
[0.691173, "o", "\u001b[2m$ kubectl -n hpc exec slurmctld-0 -c slurmctld -- sinfo\u001b[0m\r\n"]
[3.61372, "o", "PARTITION   AVAIL  TIMELIMIT  NODES  STATE NODELIST\r\nlocal-node*    up    1:00:00      1   idle bm-node-01\r\nk8s-burst      up    1:00:00      4  idle~ burst-[0-3]\r\n"]
[5.65369, "o", "\r\n"]
[5.65444, "o", "\u001b[1;36m# alice (physics) submits a 4-CPU job to the bare-metal partition\u001b[0m\r\n"]
[5.970767, "o", "\r\n\u001b[1;36m# bob (chemistry) submits two 2-CPU jobs to the k8s-burst partition\u001b[0m\r\n"]
[8.429496, "o", "\r\n"]
[8.435284, "o", "\u001b[1;36m# Slurm runs ResumeProgram: one Kubernetes pod per burst node it needs\u001b[0m\r\n"]
[17.32967, "o", "\u001b[2m$ kubectl -n hpc get pods -l app.kubernetes.io/name=slurmd-burst -o wide\u001b[0m\r\n"]
[18.204468, "o", "NAME   "]
[18.205219, "o", "   "]
[18.205357, "o", "READY"]
[18.205611, "o", "   "]
[18.205741, "o", "STATUS "]
[18.20637, "o", "   RESTARTS   AGE   IP           NODE                  NOMINATED NODE   READINESS GATES\r\nburst-0   2/2     Running"]
[18.206553, "o", "   "]
[18.207395, "o", "0          "]
[18.208193, "o", "8s    10.42.0.25   k3d-hpclab-server-0   <none>           <none>\r\nburst-1   2/2     Running   0"]
[18.209069, "o", "          8s    10.42.0.26   k3d-hpclab-server-0   <none>           <none>\r\n"]
[18.223456, "o", "\u001b[2m$ kubectl -n hpc logs slurmctld-0 -c slurmctld --tail=200 | grep k8s-power | tail -4 | jq -r .message\u001b[0m\r\n"]
[18.651409, "o", "created pod for node burst-1\r\n"]
[18.655958, "o", "registered node burst-0 at 10.42.0.25\r\nregistered node burst-1 at 10.42.0.26\r\nresume completed for burst-[0-1]\r\n"]
[28.69007, "o", "\u001b[2m$ kubectl -n hpc exec slurmctld-0 -c slurmctld -- squeue -o '%.5i %.6u %.10P %.8j %.9T %.4C %R'\u001b[0m\r\n"]
[30.36989, "o", "JOBID   USER  PARTITION     NAME     STATE CPUS NODELIST(REASON)\r\n    2    bob  k8s-burst    dft-a   RUNNING    2 burst-0\r\n    3    bob  k8s-burst    dft-b   RUNNING    2 burst-1\r\n    1  alice local-node   md-sim   RUNNING    4 bm-node-01\r\n"]
[30.424297, "o", "\r\n\u001b[1;36m# Tenant isolation: bob cannot see alice's job, and POSIX permissions keep him out of her home\u001b[0m\r\n\u001b[2m$ curl -s -o /dev/null -w '%{http_code}\\n' http://localhost:30080/job-status/1 -H \"Authorization: Bearer $BOB\"\u001b[0m\r\n"]
[31.595238, "o", "404\r\n"]
[31.595548, "o", "\u001b[2m$ docker exec bm-node-01 runuser -u bob -- ls /shared/home/alice 2>&1 || true\u001b[0m\r\n"]
[34.220226, "o", "ls: cannot open directory '/shared/home/alice': Permission denied\r\n"]
[34.297176, "o", "\r\n"]
[34.299551, "o", "\u001b[1;36m# Live metrics: open Grafana -> 'HPC Lab - Slurm & Kubernetes CPU allocation' (http://localhost:30300)\u001b[0m\r\n\r\n\u001b[1;36m# Waiting for the jobs to finish (~75s)\u001b[0m\r\n"]
[99.584346, "o", "\u001b[2m$ curl -s http://localhost:30080/job-status/2 -H \"Authorization: Bearer $BOB\" | jq -c '{job_id,state,nodes,cpus,exit_code,source}'\u001b[0m\r\n"]
[99.633033, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"job_id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m2\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"state\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"COMPLETED\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"nodes\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"burst-0\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"cpus\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m2\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"exit_code\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m0\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"source\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"sacct\"\u001b[0m\u001b[1;39m}\u001b[0m\r\n"]
[99.633491, "o", "\u001b[2m$ docker exec bm-node-01 cat /shared/home/bob/slurm-2.out\u001b[0m\r\n"]
[100.009066, "o", "[portal] job 2 on burst-0 partition=k8s-burst cpus=2 user=bob\r\ncgroup: 0::/kubepods/burstable/pod2f41d898-2312-4860-9fe2-86953f2a3ad2/ac882968e72fcb2b235f041e88ef342cab915b1880e4b0645610f414b9df2eda/system.slice/burst-0_slurmstepd.scope/job_2/step_batch/user/task_0\r\n"]
[100.013932, "o", "\r\n\u001b[1;36m# After SuspendTime (90s idle) Slurm runs SuspendProgram and the burst pods are deleted\u001b[0m\r\n\r\n\u001b[1;36m# Watch it with: watch kubectl -n hpc get pods  (or make logs)\u001b[0m\r\n"]
